{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "f1be73d3c8be48759e68159a8dcae2ac",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "WorldSpaceUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2428.999755859375,
            "y": 257.9999694824219,
            "width": 240.0,
            "height": 373.9999694824219
        }
    },
    "m_Slots": [
        {
            "m_Id": "2c011d264ab247b79925fea559624141"
        },
        {
            "m_Id": "5981918694f7463799500e480583ebbc"
        },
        {
            "m_Id": "56c0b45454e64149ba224d61773ea09f"
        },
        {
            "m_Id": "602024a024a024a024a024a024a024a0"
        },
        {
            "m_Id": "713024a024a024a024a024a024a024a0"
        },
        {
            "m_Id": "716024a024a024a024a024a024a024a0"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "WorldSpaceUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 n = normalize(worldNormal);\nfloat3 an = abs(n);\nfloat2 projected;\nfloat role;\nif (an.z >= max(an.x, an.y)) { projected = worldPos.xy; role = 0; }\nelse if (an.y >= an.x) { projected = float2(worldPos.x, n.y >= 0 ? worldPos.z : -worldPos.z); role = n.y >= 0 ? 1 : 2; }\nelse { projected = float2(n.x >= 0 ? worldPos.z : -worldPos.z, worldPos.y); role = 3; }\nfloat2 scaledCoordinate = projected * max(_WorldTiling, 0.0001);\nfloat2 logicalCell = floor(scaledCoordinate);\nfloat2 localUV = frac(scaledCoordinate);\nfloat4 rect;\nif (_UseGroundLayers > 0.5) {\n    scaledCoordinate = projected * max(_GroundCellScale, 0.0001);\n    logicalCell = floor(scaledCoordinate);\n    localUV = frac(scaledCoordinate);\n    float depth = max(0, floor(((_GroundTopY - worldPos.y) / max(_GroundCellWorldSize, 0.0001)) + 0.0001));\n    float depthColumn = depth > 255 ? 256 : depth;\n    float2 groundTexel = groundLookup.texelSize.xy;\n    float2 bandUV = float2((depthColumn + 0.5) * groundTexel.x, (_GroundLookupStartRow + 0.5) * groundTexel.y);\n    float band = floor(SAMPLE_TEXTURE2D_LOD(groundLookup.tex, groundLookup.samplerstate, bandUV, 0).r + 0.5);\n    float rectRow = _GroundLookupStartRow + 1 + band * 2;\n    float hashValue = frac(sin(dot(float4(logicalCell, depth + _GroundLookupStartRow * 17, _VisualSeed), float4(12.9898, 78.233, 37.719, 11.131))) * 43758.5453);\n    float choiceColumn = min(255, floor(hashValue * 256));\n    float2 choiceUV = float2((choiceColumn + 0.5) * groundTexel.x, (rectRow + 1.5) * groundTexel.y);\n    float variant = floor(SAMPLE_TEXTURE2D_LOD(groundLookup.tex, groundLookup.samplerstate, choiceUV, 0).r + 0.5);\n    float2 rectUV = float2((variant + 1.5) * groundTexel.x, (rectRow + 0.5) * groundTexel.y);\n    rect = SAMPLE_TEXTURE2D_LOD(groundLookup.tex, groundLookup.samplerstate, rectUV, 0);\n} else {\n    float slot = clamp(floor(uv2.x + 0.5), 0, 3);\n    float family = slot < 0.5 ? _PrimaryFamily : (slot < 1.5 ? _SecondaryFamily : (slot < 2.5 ? _AccentFamily : _SpecialFamily));\n    float rectRow = family * 8 + role * 2;\n    float2 lookupTexel = surfaceLookup.texelSize.xy;\n    float hashValue = frac(sin(dot(float4(logicalCell, family + role * 17, _VisualSeed), float4(12.9898, 78.233, 37.719, 11.131))) * 43758.5453);\n    float choiceColumn = min(255, floor(hashValue * 256));\n    float2 choiceUV = float2((choiceColumn + 0.5) * lookupTexel.x, (rectRow + 1.5) * lookupTexel.y);\n    float variant = floor(SAMPLE_TEXTURE2D_LOD(surfaceLookup.tex, surfaceLookup.samplerstate, choiceUV, 0).r + 0.5);\n    float2 rectUV = float2((variant + 1.5) * lookupTexel.x, (rectRow + 0.5) * lookupTexel.y);\n    rect = SAMPLE_TEXTURE2D_LOD(surfaceLookup.tex, surfaceLookup.samplerstate, rectUV, 0);\n}\nfloat2 atlasTexel = _BaseMap_TexelSize.xy;\nworldUV = rect.xy + atlasTexel * 0.5 + localUV * max(rect.zw - atlasTexel, 0);\n"
}

